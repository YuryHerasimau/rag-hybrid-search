# Anthropic API (pay-as-you-go на console.anthropic.com — НЕ подписка Claude Pro)
ANTHROPIC_API_KEY=sk-ant-...

# Модели
GENERATION_MODEL=claude-sonnet-5
CHEAP_MODEL=claude-haiku-4-5

# Эмбеддинги (старт — лёгкая мультиязычная; апгрейд — BAAI/bge-m3)
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Reranker (CPU-friendly)
RERANKER_MODEL=BAAI/bge-reranker-base

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=wiki

# Пути к данным
DATA_RAW_DIR=data/raw
DATA_IMAGES_DIR=data/images
